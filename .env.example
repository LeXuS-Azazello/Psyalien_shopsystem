NODE_ENV=development
LOG_LEVEL=info
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Required (at least 32 characters) if HTTP_HOST is not localhost.
API_TOKEN="HajimeNamasteTokenValue"
DATABASE_PATH=./data/psyalien.sqlite

# Confirm the CF-601's port and baud rate against the exact device configuration.
RFID_CF601_ENABLED=false
RFID_CF601_SERIAL_PORT=
RFID_CF601_SERIAL_BAUD=

# UART is between the MU910-M and ESP32; this value is for firmware configuration.
RFID_MU910_ENABLED=false
RFID_MU910_UART_BAUD=115200

ESP32_TRANSPORT=mqtt
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_TAGS=rfid/tags
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ENABLED=false
MQTT_CLIENT_ID=psyalien-engine

# Keep experimental integrations disabled until their data paths are implemented.
CCTV_ENABLED=false
CCTV_RTSP_URL=
ESP_NOW_ENABLED=false
CSI_ENABLED=false
RUVIEW_ENABLED=false
MMWAVE_ENABLED=false
