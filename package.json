{
  "name": "psyalien-shopsystem",
  "version": "1.0.0",
  "description": "Self-hosted TypeScript inventory engine with RFID, camera, and sensor integrations",
  "keywords": [
    "RFID",
    "UHF",
    "CCTV",
    "shop",
    "security"
  ],
  "homepage": "https://github.com/LeXuS-Azazello/Psyalien_shopsystem#readme",
  "bugs": {
    "url": "https://github.com/LeXuS-Azazello/Psyalien_shopsystem/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeXuS-Azazello/Psyalien_shopsystem.git"
  },
  "license": "ISC",
  "author": "soldatoff@debug.org.ua",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/main.ts",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "dev:all": "bash scripts/dev.sh",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json",
    "cf601:scan": "python3 scripts/cf601_usb.py",
    "test:cf601": "python3 -m unittest discover -s test -p 'cf601_usb_test.py' -v",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit && npm run web:typecheck",
    "test": "node --env-file-if-exists=.env --experimental-strip-types --test"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "mqtt": "^5.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
